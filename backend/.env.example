# ---- App ----
PROJECT_NAME="Axiora WhatsApp Marketing"
API_V1_PREFIX="/api/v1"
ENVIRONMENT="development"           # development | production
BACKEND_CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# ---- Security ----
# Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY="change-me-super-secret-key"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Fernet key for encrypting API credentials.
# Generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY="change-me-generate-a-fernet-key="

# ---- Database ----
# Local dev default is SQLite. For Postgres use e.g.:
# DATABASE_URL="postgresql+psycopg2://axiora:axiora@db:5432/axiora"
DATABASE_URL="sqlite:///./axiora.db"

# ---- Celery / Redis (optional; falls back to FastAPI BackgroundTasks) ----
USE_CELERY=false
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/1"

# ---- Storage ----
STORAGE_BACKEND="local"             # local | s3
MEDIA_ROOT="./media"

# ---- Email (verification / reset) ----
# Leave SMTP_HOST empty in dev to log emails to console instead of sending.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
EMAILS_FROM_EMAIL="no-reply@axiora.local"
FRONTEND_URL="http://localhost:5173"

# ---- WhatsApp Cloud API (fallback defaults; per-user settings override these) ----
WHATSAPP_API_BASE="https://graph.facebook.com/v20.0"

# ---- Sending engine ----
SEND_BATCH_SIZE=25
SEND_RATE_PER_SECOND=10
MAX_SEND_RETRIES=3
