# ---- App ----
PROJECT_NAME="Axiora WhatsApp Marketing"
API_V1_PREFIX="/api/v1"
ENVIRONMENT="development"           # development | production
BACKEND_CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# ---- Security ----
# Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY="change-me-super-secret-key"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Fernet key for encrypting API credentials.
# Generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY="change-me-generate-a-fernet-key="

# ---- Database ----
# Local dev default is SQLite. For Postgres use e.g.:
# DATABASE_URL="postgresql+psycopg2://axiora:axiora@db:5432/axiora"
# On Vercel, use your provider's pooled connection string (e.g. Neon's
# "-pooler" host, or Supabase's port-6543 pgbouncer URL).
DATABASE_URL="sqlite:///./axiora.db"
# Set true only when running on a serverless host (Vercel). Leave false on
# Render/Railway/Fly/Docker so the app keeps a normal connection pool.
DATABASE_SERVERLESS=false

# ---- Celery / Redis (optional; falls back to FastAPI BackgroundTasks) ----
# Vercel functions can't run a Celery worker; keep this false there.
USE_CELERY=false
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/1"

# ---- Storage ----
# local = disk under MEDIA_ROOT (fine for Docker/Render/Railway).
# s3 = required on Vercel, whose filesystem is read-only/ephemeral outside /tmp.
STORAGE_BACKEND="local"             # local | s3
MEDIA_ROOT="./media"

# ---- S3-compatible storage (only used when STORAGE_BACKEND=s3) ----
# Works with AWS S3, Cloudflare R2, Supabase Storage, MinIO, etc.
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Leave empty for AWS S3. Set for R2/MinIO/Supabase, e.g. https://<acct>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=""
# Optional CDN/custom domain fronting the bucket; defaults to the bucket's own URL.
S3_PUBLIC_URL_BASE=""
# true for R2/MinIO (path-style URLs); false for AWS S3.
S3_USE_PATH_STYLE=false

# ---- Email (verification / reset) ----
# Leave SMTP_HOST empty in dev to log emails to console instead of sending.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
EMAILS_FROM_EMAIL="no-reply@axiora.local"
FRONTEND_URL="http://localhost:5173"

# ---- WhatsApp Cloud API (fallback defaults; per-user settings override these) ----
WHATSAPP_API_BASE="https://graph.facebook.com/v20.0"

# ---- Sending engine ----
SEND_BATCH_SIZE=25
SEND_RATE_PER_SECOND=10
MAX_SEND_RETRIES=3
